{
  "name": "easy-jawi-functions",
  "private": true,
  "description": "Authoritative EASY JAWI multiplayer server (Cloud Functions for Firebase)",
  "main": "lib/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/index.js --external:firebase-admin --external:firebase-functions --log-level=warning"
  },
  "dependencies": {
    "firebase-admin": "13.10.0",
    "firebase-functions": "6.6.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
