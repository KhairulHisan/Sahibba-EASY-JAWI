# The public Firebase web config of the sahibba-easy-jawi project is built in
# (src/lib/firebaseConfig.ts). Override here only to use ANOTHER project.
# These values identify a project; they are NOT secrets.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Cloud Functions deployed (Blaze plan): set by .env.production for `npm run build`.
# VITE_CLOUD_FUNCTIONS=1

# Firebase App Check (reCAPTCHA Enterprise site key — public, not a secret).
# VITE_APPCHECK_SITE_KEY=

# Local development against the Emulator Suite instead (npm run emulators):
# VITE_FIREBASE_EMULATOR=1
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
