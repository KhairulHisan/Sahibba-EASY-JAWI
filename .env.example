# Firebase web app config (Firebase console → Project settings → Your apps → Web).
# These identify the project; they are NOT secrets. Security comes from
# firestore.rules and the Cloud Functions, not from hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development against the Emulator Suite instead (npm run emulators):
# VITE_FIREBASE_EMULATOR=1
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
